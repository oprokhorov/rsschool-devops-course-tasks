pipeline {
    agent {
        kubernetes {
            yaml """
                apiVersion: v1
                kind: Pod
                spec:
                  serviceAccountName: jenkins
                  containers:
                    - name: helm
                      image: alpine/helm:latest
                      command: [ "cat" ]
                      tty: true
                    - name: kubectl
                      image: dtzar/helm-kubectl:latest
                      command: [ "cat" ]
                      tty: true
            """
        }
    }

    // Moved parameter definition to JcasC
    // parameters {
    //     string(name: 'NAMESPACE',
    //     defaultValue: 'monitoring',
    //     description: 'Namespace to deploy monitoring stack into')
    // }

    stages {

        stage('Ensure Namespace Exists') {
            steps {
                container('kubectl') {
                    sh '''
                        echo "Using namespace: ${NAMESPACE}"
                        kubectl get ns "${NAMESPACE}" || kubectl create ns "${NAMESPACE}"
                    '''
                }
            }
        }

        stage('Create Secrets') {
            steps {
                container('kubectl') {
                    withCredentials([
                        string(credentialsId: 'grafana-admin-password', variable: 'GRAFANA_ADMIN_PASSWORD'),
                        usernamePassword(credentialsId: 'gmail-smtp', usernameVariable: 'SMTP_USER', passwordVariable: 'SMTP_PASSWORD')
                    ]) {
                        sh '''
                            set -euo pipefail
                            kubectl create secret generic grafana-credentials \\
                              --namespace "${NAMESPACE}" \\
                              --from-literal=grafana-admin-password="$GRAFANA_ADMIN_PASSWORD" \\
                              --from-literal=smtp-user="$SMTP_USER" \\
                              --from-literal=smtp-password="$SMTP_PASSWORD" \\
                              --dry-run=client -o yaml | kubectl apply -f -
                            
                            kubectl get secret -n monitoring grafana-credentials
                        '''
                    }
                }
            }
        }

        stage('Deploy Monitoring Stack') {
            steps {
                container('helm') {
                    withCredentials([usernamePassword(credentialsId: 'gmail-smtp', usernameVariable: 'SMTP_USER', passwordVariable: 'SMTP_PASSWORD')]) {
                        sh '''
                            set -euo pipefail

                            helm repo add bitnami https://charts.bitnami.com/bitnami || true
                            helm repo update

                            helm upgrade --install prometheus-stack bitnami/kube-prometheus \\
                              --namespace "${NAMESPACE}" \\
                              --wait

                            helm upgrade --install grafana bitnami/grafana \\
                              --namespace "${NAMESPACE}" \\
                              --set smtp.fromAddress="$SMTP_USER" \\
                              -f ./monitoring/grafana-values.yaml \\
                              --wait
                        '''
                    }
                }
            }
        }
    }
}
